# OS junk
.DS_Store
Thumbs.db

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo

# MCP browser-tool session artifacts (screenshots, page snapshots, console logs)
.playwright-mcp/

# Node / npm
node_modules/
npm-debug.log*

# Go
*.test
*.out
/cli/dist/
/cli/bin/

# Secrets / env (never commit these)
.env
.env.*
!.env.example

# Tolvi local caches
.tolvi/cache/
.tolvi-index/
/examples/sample-vault/.tolvi-index/

# Private working docs (not for the public repo)
tolvi-build-plan.md
# Engineering-process artifacts (implementation plans/specs) — maintainer-only;
# contain local paths and internal process, kept out of the public repo.
docs/superpowers/

# Per-repo engineering vault. Contributor-fed and world-safe: it holds this
# repo's decisions and, in single-root mode, a contributor's own session notes.
# Maintainer session context routes to a private org root instead and never
# lands here — see the vault topology decisions. The synthetic demo vault at
# examples/sample-vault/ remains the canonical example for consumers.
